    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-native": "^0.82.1",
    "typescript": "^5.9.3"
